{
  "name": "compas",
  "description": "Compás — a tango DJ player. Live player + tanda builder, built on the vite-electron-builder template.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "compile": "pnpm run build && electron-builder build --config electron-builder.mjs",
    "start": "node packages/dev-mode.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@npmcli/map-workspaces": "5.0.3",
    "@types/node": "25.5.0",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "glob": "13.0.6"
  },
  "dependencies": {
    "@app/main": "*",
    "@app/preload": "*",
    "@app/renderer": "*"
  }
}
