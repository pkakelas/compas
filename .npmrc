# Use a flat, hoisted node_modules so Electron + electron-builder resolve
# binaries the same way they do under npm.
node-linker=hoisted

# Vite plugins occasionally lag a major version behind Vite's peer range.
strict-peer-dependencies=false

# The template declares internal packages with the "*" range (npm style) rather
# than "workspace:*"; tell pnpm to link them from the workspace anyway.
link-workspace-packages=true
